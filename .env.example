# Proyecto de Supabase. Estas dos son públicas (llegan al navegador):
# la seguridad real la ponen las políticas RLS de la base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role). SÓLO servidor: nunca con NEXT_PUBLIC_.
# Saltea la RLS; la app la usa para resolver usuario → email en el login.
# Sin ella, el ingreso con nombre de usuario se deshabilita (con email anda igual).
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Lo manda el cron de Vercel en el encabezado Authorization
CRON_SECRET=
